# ===== Google Sheets connection =====
# อีเมลของ Service Account (ลงท้ายด้วย .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key จากไฟล์ JSON ของ Service Account
# วางทั้งก้อนในเครื่องหมายคำพูด และคง \n ไว้ตามเดิม (ห้ามลบ)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...ทั้งก้อน...==\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID (ค่าเริ่มต้นคือชีทที่ตกลงไว้)
SHEET_ID=1NzkfO_G0pa0fZMvuMlIzaLp-oUx5KAat_GVzng5xSKE

# ===== ความเร็ว (ไม่ใส่ก็ได้ — มีค่าตั้งต้นให้แล้ว) =====
# อายุ cache ฝั่ง server ของข้อมูลที่อ่านจากชีท (มิลลิวินาที) — ตั้งต้น 30000 = 30 วินาที
# ยิ่งมาก = เปิดหน้าเร็วขึ้น/ประหยัดโควต้ามากขึ้น แต่ถ้ามีคนแก้ชีทตรง ๆ จะเห็นช้าลงตามนี้
# (บันทึกผ่านเว็บเห็นทันทีเสมอ · ปุ่ม "รีเฟรช" บังคับอ่านสดได้ตลอด)
SHEET_CACHE_TTL_MS=30000

# อายุ cache ของ "รายชื่อ tab" — ตั้งต้น 300000 = 5 นาที (แทบไม่เปลี่ยน ตั้งยาวได้)
SHEET_META_TTL_MS=300000
